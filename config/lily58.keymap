#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        to_kp: to_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// |BSPC/L1|A/CTL|S/ALT|D/CMD |F/SFT |  G   |                   |  H   |J/SFT  |K/CMD  |L/ALT | ;/CTL | '/L2  |
// |ESC/SFT|  Z  |  X  |  C   |  V   |  B   |  n/a   |  |  n/a  |  N   |  M    |  ,    |  .   |   /   |CAP/SFT|
//                     |DEL/L2|RET/L1|SPC/CMD|  n/a   |  |  n/a  |RET/CMD|SPC/L1 |BSPC/L2|
// Note: Silakka54 has 54 keys - the 4 positions marked n/a are not present (inner thumb + encoder positions)
            display-name = "Base";
            bindings = <
&kp GRAVE     &kp N1       &kp N2      &kp N3      &kp N4       &kp N5                      &kp N6    &kp N7       &kp N8      &kp N9      &kp N0         &kp MINUS
&kp TAB       &kp Q        &kp W       &kp E       &kp R        &kp T                       &kp Y     &kp U        &kp I       &kp O       &kp P          &kp BSLH
&to_kp 1 BSPC &mt LCTRL A  &mt LALT S  &mt LGUI D  &mt LSHFT F  &kp G                       &kp H     &mt RSHFT J  &mt RGUI K  &mt RALT L  &mt RCTRL SEMI &to_kp 2 SQT
&mt LSHFT ESC &kp Z        &kp X       &kp C       &kp V        &kp B  &none      &none     &kp N     &kp M        &kp COMMA   &kp DOT     &kp FSLH       &mt RSHFT CAPS
                                       &lt 2 DEL   &lt 1 RET    &mt LGUI SPACE &none   &none     &mt RGUI RET &lt 1 SPACE &lt 2 BSPC
            >;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       |  +  |  ^  |  -   |  (   |  )   |                   | HOME | PGDN  | PGUP  | END  |   {   |  F12  |
// |  TO 0 |  <- |  v  |  ->  |  [   |  ]   |                   |  <-  |   v   |  ^    |  ->  |   }   |       |
// |       |  *  |  /  |  =   |  {   |  }   |  n/a   |  |  n/a  |  +   |   -   |  *    |  /   |   =   |       |
//                     |      |      |      |  n/a   |  |  n/a  |      |       |       |
            display-name = "Lower";
            bindings = <
&trans &kp F1   &kp F2   &kp F3    &kp F4    &kp F5                       &kp F6   &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
&trans &kp PLUS &kp UP   &kp MINUS &kp LPAR  &kp RPAR                     &kp HOME &kp PG_DN &kp PG_UP &kp END   &kp LBRC  &kp F12
&to 0  &kp LEFT &kp DOWN &kp RIGHT &kp LBKT  &kp RBKT                     &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp RBRC  &trans
&trans &kp STAR &kp FSLH &kp EQUAL &kp LBRC  &kp RBRC  &none     &none    &kp PLUS &kp MINUS &kp STAR  &kp FSLH  &kp EQUAL &trans
                         &trans    &trans    &trans    &none     &none    &trans   &trans    &trans
            >;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   | PREV | NEXT  | PLAY  | MUTE | VOL-  | VOL+  |
// |       |     |     |      |      |      |                   |  7   |  8    |  9    |  +   |   -   |  RET  |
// |       |     |     |      |      |      |                   |  4   |  5    |  6    |  *   |   /   | TO 0  |
// |       |     |     |      |      |      |  n/a   |  |  n/a  |  1   |  2    |  3    |  0   |   =   |   .   |
//                     |      |      |      |  n/a   |  |  n/a  |      |       |       |
            display-name = "Raise";
            bindings = <
&trans &trans &trans &trans &trans &trans                       &kp C_PREV &kp C_NEXT &kp C_PP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP
&trans &trans &trans &trans &trans &trans                       &kp N7     &kp N8     &kp N9   &kp KP_PLUS &kp KP_MINUS &kp RET
&trans &trans &trans &trans &trans &trans                       &kp N4     &kp N5     &kp N6   &kp KP_MULTIPLY &kp KP_DIVIDE &to 0
&trans &trans &trans &trans &trans &trans    &none      &none   &kp N1     &kp N2     &kp N3   &kp N0     &kp KP_EQUAL &kp KP_DOT
                     &trans &trans &trans    &none      &none   &trans     &trans     &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
